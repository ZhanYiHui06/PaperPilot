{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["electron/*"],
      "@db/*": ["database/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "electron/**/*",
    "database/**/*",
    "scripts/**/*",
    "shared/**/*",
    "electron.vite.config.ts"
  ]
}
