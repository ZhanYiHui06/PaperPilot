{
  "name": "paperpilot",
  "version": "1.0.0-alpha",
  "main": "./out/main/index.js",
  "author": {
    "name": "ZhanYiHui06",
    "email": "zhanyihui06@gmail.com"
  },
  "homepage": "https://github.com/ZhanYiHui06/PaperPilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhanYiHui06/PaperPilot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:llm": "tsx scripts/test-llm.ts",
    "generate-icon": "node scripts/generate-icon.mjs",
    "seed:demo": "npx electron scripts/seed-electron-runner.cjs",
    "dist:win:x64": "electron-builder --win --x64 && powershell -Command \"Rename-Item 'dist/PaperPilot Setup 1.0.0-alpha.exe' 'PaperPilot-Setup-1.0.0-alpha-x64.exe' -Force\"",
    "dist:win:arm64": "electron-builder --win --arm64 && powershell -Command \"Rename-Item 'dist/PaperPilot Setup 1.0.0-alpha.exe' 'PaperPilot-Setup-1.0.0-alpha-arm64.exe' -Force\"",
    "dist:win": "electron-vite build && npm run dist:win:x64 && npm run dist:win:arm64",
    "dist:mac": "electron-vite build && electron-builder --mac --x64 && electron-builder --mac --arm64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 && electron-builder --linux --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@lobehub/fluent-emoji": "^1.0.0",
    "@lobehub/icons": "^5.0.0",
    "@lobehub/ui": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.0.0",
    "antd-style": "^3.7.1",
    "better-sqlite3": "^11.3.0",
    "codemirror": "^5.65.0",
    "date-fns": "^4.1.0",
    "imapflow": "^1.0.0",
    "lucide-react": "^0.469.0",
    "mailparser": "^3.9.14",
    "motion": "^12.0.0",
    "openai": "^4.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "simple-git": "^3.27.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "sharp": "^0.33.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.paperpilot.app",
    "productName": "PaperPilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "database/schema.sql",
        "to": "database/schema.sql"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaperPilot"
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "ZhanYiHui06 <zhanyihui06@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
